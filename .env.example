# Port d'écoute du serveur
PORT=3000

# Mot de passe de la base PostgreSQL (lettres et chiffres uniquement : il est repris dans une URL)
POSTGRES_PASSWORD=change-moi-aussi

# Adresse de la base pour « npm start » hors Docker (Docker la remplace automatiquement)
DATABASE_URL=postgres://calendrier:change-moi-aussi@localhost:5432/calendrier

# Premier compte super admin, créé uniquement si la base ne contient encore aucun compte.
# Ensuite, les comptes se gèrent dans le backoffice et ces deux lignes ne servent plus.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-moi

# Secret de signature des sessions (une longue chaîne aléatoire)
SESSION_SECRET=remplace-par-une-longue-chaine-aleatoire

# Pour tester : force la date du jour (format AAAA-MM-JJ). Laisser vide en production.
DATE_SIMULEE=

# Mettre 1 quand le site est servi en HTTPS derrière un proxy ou un tunnel
# (cookie de session envoyé uniquement en HTTPS). Laisser vide en HTTP local.
TRUST_PROXY=

# Nom de domaine public pour le HTTPS (profil « https » de docker-compose), ex. monnom.freeboxos.fr
DOMAINE=
